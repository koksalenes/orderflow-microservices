# Local development settings for docker-compose.yml.
# Copy to .env (`make env`) and change the values. Never commit .env.

# PostgreSQL
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_DEFAULT_USER=orderflow
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8080

# Aspire
ASPIRE_DASHBOARD_PORT=18888
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Gateway (YARP)
GATEWAY_PORT=8000

# Application containers
APP_ENVIRONMENT=Production
DOCKER_SUBNET=10.201.0.0/24
DOCKER_DYNAMIC_IP_RANGE=10.201.0.128/25
GATEWAY_IP=10.201.0.10
