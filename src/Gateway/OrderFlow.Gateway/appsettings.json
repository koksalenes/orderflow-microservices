{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "Yarp": "Warning",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
      }
    }
  },
  "GracefulShutdown": {
    "TimeoutSeconds": 30,
    "DrainDelaySeconds": 5
  },
  "HttpLogging": {
    "LogBodies": false,
    "BodyLogLimit": 4096
  },
  "RequestLimits": {
    "MaxRequestBodyBytes": 1048576
  },
  "RateLimiting": {
    "PermitsPerSecond": 50,
    "Burst": 100,
    "WritePermitsPerSecond": 10,
    "WriteBurst": 20,
    "ConcurrentRequests": 50
  },
  "ReverseProxy": {
    "Routes": {
      "products": {
        "ClusterId": "products",
        "Match": {
          "Path": "/api/v{version:int}/products/{**rest}"
        }
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/v{version:int}/inventory/{**rest}"
        }
      },
      "orders": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/v{version:int}/orders/{**rest}"
        }
      },
      "payments": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/v{version:int}/payments/{**rest}"
        }
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": {
          "Path": "/api/v{version:int}/notifications/{**rest}"
        }
      }
    },
    "Clusters": {
      "products": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5101"
          }
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:02",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        }
      },
      "inventory": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5103"
          }
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:02",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        }
      },
      "orders": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5105"
          }
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:02",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        }
      },
      "payments": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5107"
          }
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:02",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        }
      },
      "notifications": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5109"
          }
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:02",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        }
      }
    }
  }
}
