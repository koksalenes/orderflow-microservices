{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "GracefulShutdown": {
    "TimeoutSeconds": 30,
    "DrainDelaySeconds": 5
  },
  "HttpLogging": {
    "LogBodies": false,
    "BodyLogLimit": 4096
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  },
  "TrustedProxy": {
    "KnownNetworks": [],
    "KnownProxies": []
  },
  "Session": {
    "CookieName": "orderflow.session",
    "LifetimeHours": 336
  },
  "Oidc": {
    "Authority": "http://localhost:8080/realms/orderflow",
    "ClientId": "orderflow-bff",
    "RequireHttpsMetadata": true
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "gateway",
        "Match": {
          "Path": "/api/{**rest}"
        }
      }
    },
    "Clusters": {
      "gateway": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5100"
          }
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      }
    }
  }
}
