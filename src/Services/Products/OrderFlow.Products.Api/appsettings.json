{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
      }
    }
  },
  "GracefulShutdown": {
    "TimeoutSeconds": 30,
    "DrainDelaySeconds": 5
  },
  "HttpLogging": {
    "LogBodies": false,
    "BodyLogLimit": 4096
  },
  "TrustedProxy": {
    "KnownNetworks": [],
    "KnownProxies": []
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
