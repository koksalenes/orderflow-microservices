{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "GracefulShutdown": {
    "TimeoutSeconds": 30,
    "DrainDelaySeconds": 5
  },
  "TrustedProxy": {
    "KnownNetworks": [],
    "KnownProxies": []
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
