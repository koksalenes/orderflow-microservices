{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "GracefulShutdown": {
    "TimeoutSeconds": 30,
    "DrainDelaySeconds": 0
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "orderflow"
  },
  "Outbox": {
    "PollIntervalMilliseconds": 1000,
    "BatchSize": 50
  },
  "EventStore": {
    "SnapshotInterval": 5
  },
  "CardNetwork": {
    "SettlementDelaySeconds": 8,
    "FailingCardLast4": "0119"
  }
}
