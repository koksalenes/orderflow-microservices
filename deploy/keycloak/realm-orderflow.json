{
  "realm": "orderflow",
  "displayName": "OrderFlow",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "customer", "description": "Places orders and pays for them." },
      { "name": "admin", "description": "Manages products, stock and orders." }
    ]
  },
  "clients": [
    {
      "clientId": "orderflow-api",
      "name": "OrderFlow APIs",
      "description": "Audience of the access tokens accepted by every service API. No login flow.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "orderflow-dev",
      "name": "OrderFlow local development",
      "description": "Public PKCE client for trying the APIs from Scalar on localhost.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5101/*",
        "http://localhost:5103/*",
        "http://localhost:5105/*",
        "http://localhost:5107/*",
        "http://localhost:5109/*"
      ],
      "webOrigins": ["+"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "orderflow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "orderflow-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "orderflow-orders-svc",
      "name": "Orders service account",
      "description": "Client credentials for service-to-service gRPC calls made by Orders. The secret is generated by Keycloak.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "orderflow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "orderflow-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
